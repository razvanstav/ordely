# Development only. Copy to .env; never commit real credentials.
APP_ENV=dev
APP_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=33060
DB_NAME=ordely
DB_TEST_NAME=ordely_test
DB_USER=ordely
DB_PASSWORD=ordely_local_only
MYSQL_ROOT_PASSWORD=root_local_only
# Optional absolute path; default is var/keys/keyring.json (create with php bin/keyring.php).
# ORDELY_KEYRING_FILE=/run/secrets/ordely-keyring.json
# Shopify CLI writes SHOPIFY_API_KEY and SHOPIFY_API_SECRET using app env pull.
# The explicit allowlist is mandatory in development; use a separate dev store.
# ORDELY_SHOPIFY_DEV_STORE=ordely-shop.myshopify.com
